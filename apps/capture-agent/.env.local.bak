# GTD capture-agent — local config
# AI Service endpoint (docker container)
AGENT_ENDPOINT=http://localhost:3030
AGENT_AUTH_TOKEN=dev-http-token-gtd-automation-2026

# Screenshot + OCR cadence (1 min default; 30s during Sonnet vision rollout 2026-05-14)
AGENT_INTERVAL_MS=30000

# OCR — eng+rus runs both traineddata models so Cyrillic glyphs are no longer
# mistaken for visual Latin lookalikes (К/K, М/M, Н/H, etc.). Requires
# rus.traineddata alongside eng.traineddata in this directory.
AGENT_OCR_LANG=eng+rus
AGENT_MIN_OCR_LENGTH=30

# Audio backend: "native" (Swift AVAudioEngine helper, recommended on macOS
# multi-channel mics) or "ffmpeg" (legacy avfoundation).
AGENT_AUDIO_ENABLED=true
# native helper now uses AVCaptureSession (not AVAudioEngine/VPIO), so it
# coexists with Zoom/Meet/Teams without ducking. Mic mode (Standard /
# Voice Isolation / Wide Spectrum) is chosen by the user via Control
# Center → Microphone — pick "Voice Isolation" for cleanest input.
AGENT_AUDIO_BACKEND=native
# Skip VoiceProcessingIO setup in the native helper (default: off — leave VP
# attempted; without code-signing it's a no-op but the manual mono downmix
# still works).
# AGENT_AUDIO_NO_VP=true
# Override helper binary path if needed (default: ../audio-helper/gtd-audio-capture).
# AGENT_AUDIO_HELPER_PATH=

# Speaker diarization (FluidAudio, runs on every audio chunk if profile set).
# Disable with AGENT_AUDIO_DIARIZE_DISABLED=true.
# Override binary path with AGENT_AUDIO_DIARIZE_BINARY.
# Voice profile JSON from `bun run enroll` — empty = anonymous diarization.
AGENT_VOICE_PROFILE_PATH=/Users/sergeykurdyuk/.gtd-voice-profile.json
# Diarizer thresholds (tune after watching <stem>.diarize.json sidecar files).
# Clustering: lower = more aggressive speaker-splitting (default 0.7).
# User-match: higher = stricter is_user gate via cosine similarity (default 0.55).
AGENT_DIARIZE_CLUSTERING_THRESHOLD=0.7
# Calibration (2026-05-13): user-only chunks score 0.63-0.69, mixed chunks
# user-segments score ~0.50, assistant/ambient ≤0.35. Threshold 0.50 keeps
# user under mixed conditions without admitting other speakers.
AGENT_DIARIZE_USER_MATCH_THRESHOLD=0.50
# Retain the captured WAV alongside the wiki MD for offline re-diarization.
# Adds ~1 MB per 30 s chunk. Useful while tuning thresholds.
AGENT_AUDIO_KEEP_WAV=false

# ffmpeg-backend settings (used only when AGENT_AUDIO_BACKEND=ffmpeg). Input
# device picker uses the system default; pick a specific avfoundation index
# with e.g. ":4" for an external USB mic.
AGENT_AUDIO_INPUT_DEVICE=:default
AGENT_AUDIO_CHUNK_MS=30000
AGENT_AUDIO_ENERGY_THRESHOLD=0.005

# STT — codex Whisper-shape endpoint (OpenAI-compatible)
AGENT_OPENAI_BASE_URL=http://54.183.85.48:20131/v1
AGENT_OPENAI_API_KEY=sk-codex-stt-e73731d5ac956dfb248f994be31e5ed0
AGENT_WHISPER_MODEL=whisper-1
AGENT_WHISPER_LANGUAGE=ru
AGENT_WHISPER_PROMPT=Разговор разработчика на русском про задачи, проекты, дедлайны, GTD.

# Pause flag — delete the file at this path to resume; create it to pause.
AGENT_PAUSE_FLAG=/Users/sergeykurdyuk/.gtd-paused

# Wiki — append-only MD log of every capture (one file per event). Empty = disabled.
AGENT_WIKI_DIR=/Users/sergeykurdyuk/Projects/GTD_automation/wiki

# Persist screenshot image alongside each screen capture (false to disable).
AGENT_WIKI_SAVE_IMAGE=true
# Resize the longest edge to N pixels and convert to JPEG (0 = save raw PNG).
AGENT_WIKI_IMAGE_MAX_EDGE=1280
AGENT_WIKI_IMAGE_QUALITY=65

# Rollup LLM (reuses mindwtr's LLM proxy at ec2 — same as docker/.env LLM_BASE_URL).
WIKI_LLM_BASE_URL=http://ec2-54-183-85-48.us-west-1.compute.amazonaws.com:20128/v1
WIKI_LLM_API_KEY=sk-d987b804eaa3718b-j5e2hf-6357217e
WIKI_LLM_MODEL=cc/claude-opus-4-6
WIKI_ROLLUP_INTERVAL_MS=600000

# Multi-display capture (true = all screens, false = primary only).
AGENT_MULTI_DISPLAY=true
# Apps where screen captures go to wiki only (NOT to AI Service inbox).
# Case-insensitive substring match. Default covers code editors + LLM chat
# clients. Empty = disabled.
AGENT_WIKI_ONLY_APPS=Code,Cursor,Claude,Windsurf,Zed,Xcode
