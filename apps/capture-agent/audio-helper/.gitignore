# Compiled binaries live at audio-helper/ root (rebuild via build.sh).
# Anchored to / so we don't accidentally ignore Sources/gtd-audio-capture/ etc.
/gtd-audio-capture
/gtd-audio-capture.dSYM/
/gtd-audio-enroll
/gtd-audio-enroll.dSYM/
/gtd-audio-diarize
/gtd-audio-diarize.dSYM/

# .app bundle build artefacts. The Info.plist AT audio-helper root IS the
# template (tracked); the copy inside Contents/ plus the signed binary and
# code signature are regenerated by build.sh and shouldn't be committed.
/GTDAudioCapture.app/

# Swift Package Manager artefacts.
.build/
.swiftpm/
Package.resolved
