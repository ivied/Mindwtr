# Mindwtr Cloud auth token (used by both cloud server and ai-service)
MINDWTR_CLOUD_AUTH_TOKENS=your-secret-token-here

# Telegram Bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# LLM provider (OpenAI-compatible, e.g. 9Router)
LLM_BASE_URL=http://your-llm-proxy/v1
LLM_API_KEY=sk-your-llm-api-key
# Two tiers behind one proxy. Heavy reasoning nodes (Proposer, Enricher,
# Reviser, ProactiveRunner, RecordingDistiller) use OPUS; lightweight
# classify/select/extract/summarize nodes use SONNET. Each tier falls back to
# the other when its model errors on the proxy.
LLM_MODEL_OPUS=cx/gpt-5.5
LLM_MODEL_SONNET=cx/gpt-5.4-mini

# Slack (optional) — user-token polling, "see what I see" across workspaces.
# Per workspace: create a Slack App (From manifest), add User Token Scopes
# (channels:history, groups:history, im:history, mpim:history, *:read,
# users:read), Install to Workspace, copy the xoxp- User OAuth Token.
# One token per workspace, comma-separated.
# SLACK_USER_TOKENS=xoxp-aaa,xoxp-bbb
# SLACK_POLL_INTERVAL_MS=300000
#
# Slack SESSION tokens (optional) — for workspaces where you CAN'T install an
# app. Telethon-style: reuse your own browser session, no OAuth. Format is
# `xoxc-token|xoxd-cookie` pairs, comma-separated. Against Slack ToS and the
# xoxc token rotates (hours→weeks) — on expiry the workspace logs invalid_auth
# and goes idle until you re-extract. Validate first with:
#   SLACK_SESSION_TOKENS='xoxc-...|xoxd-...' npx tsx scripts/slack-session-probe.ts
# Extract (browser logged into the workspace):
#   xoxc — DevTools Console:
#     JSON.parse(localStorage.localConfig_v2).teams[location.pathname.match(/^\/client\/([A-Z0-9]+)/)[1]].token
#   xoxd — DevTools → Application → Cookies → app.slack.com → `d` (starts xoxd-)
# SLACK_SESSION_TOKENS=xoxc-...|xoxd-...,xoxc-...|xoxd-...
#
# Team allowlist — comma-separated Slack team IDs. The browser extension pushes
# every signed-in workspace; this polls only the listed ones (the rest are
# authenticated but ignored). Empty = poll all. Find team IDs in the
# /v1/slack/session push logs or the Slack URL (app.slack.com/client/T0XXXX).
# SLACK_TEAM_ALLOWLIST=T0G9HKDFX,T3ZAW599A,TAV2LJ67K
#
# Commitment LLM batching for Slack — drain queued captures on this interval
# (ms) instead of one LLM call per message. Defaults to SLACK_POLL_INTERVAL_MS.
# COMMITMENT_BATCH_INTERVAL_MS=300000
# COMMITMENT_BATCH_MAX=30

# Telegram user-account feed (optional) — MTProto client on your PERSONAL
# account: captures incoming DMs + group messages ("see what I see").
# Channels/broadcasts, own messages and bots are skipped. Batched through the
# same commitment batcher as Slack.
# 1. Get api_id + api_hash at https://my.telegram.org → API development tools
# 2. One-time interactive login (writes session into the data volume):
#      cd apps/ai-service && TELEGRAM_API_ID=... TELEGRAM_API_HASH=... \
#        DATA_DIR=<data volume path> bun run scripts/telegram-login.ts
# 3. Set both vars and restart ai-service.
# TELEGRAM_API_ID=1234567
# TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Notion (optional) — self-created Internal Integration
# https://www.notion.so/my-integrations → New integration
# Share target database with the integration
# NOTION_API_KEY=secret_...
# NOTION_DATABASE_ID=...
# NOTION_POLL_INTERVAL_MS=300000

# HTTP capture endpoint (optional) — used by desktop capture-agent
# Set to enable POST /v1/capture; pick a long random token.
# HTTP_AUTH_TOKEN=
# HTTP_PORT=3030

# Context Store embeddings (optional but recommended).
# Without OPENAI_API_KEY: Context Store works in FTS-only mode (no semantic search).
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_MODEL=text-embedding-3-small
# CONTEXT_STORE_TTL_DAYS=7

# Claude Code thread registry (powers ai-target routing of @ai-agent tasks).
# Host dir the ai-service container mounts read-only at /app/claude-projects.
# On a machine where you run Claude Code, point at ~/.claude/projects.
# When threads live on another Mac, mirror them locally (see
# docker/sync-claude-threads.sh + the com.mindwtr.claude-threads-sync launchd
# agent) and point this at the synced copy.
# CLAUDE_PROJECTS_HOST_DIR=/Users/you/claude-projects-sync
