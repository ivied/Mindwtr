# Mindwtr Cloud auth token (used by both cloud server and ai-service)
MINDWTR_CLOUD_AUTH_TOKENS=your-secret-token-here

# Telegram Bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# LLM provider (OpenAI-compatible, e.g. 9Router)
LLM_BASE_URL=http://your-llm-proxy/v1
LLM_API_KEY=sk-your-llm-api-key
LLM_MODEL=cc/claude-opus-4-6

# Slack (optional) — user-token polling, "see what I see" across workspaces.
# Per workspace: create a Slack App (From manifest), add User Token Scopes
# (channels:history, groups:history, im:history, mpim:history, *:read,
# users:read), Install to Workspace, copy the xoxp- User OAuth Token.
# One token per workspace, comma-separated.
# SLACK_USER_TOKENS=xoxp-aaa,xoxp-bbb
# SLACK_POLL_INTERVAL_MS=300000
#
# Slack SESSION tokens (optional) — for workspaces where you CAN'T install an
# app. Telethon-style: reuse your own browser session, no OAuth. Format is
# `xoxc-token|xoxd-cookie` pairs, comma-separated. Against Slack ToS and the
# xoxc token rotates (hours→weeks) — on expiry the workspace logs invalid_auth
# and goes idle until you re-extract. Validate first with:
#   SLACK_SESSION_TOKENS='xoxc-...|xoxd-...' npx tsx scripts/slack-session-probe.ts
# Extract (browser logged into the workspace):
#   xoxc — DevTools Console:
#     JSON.parse(localStorage.localConfig_v2).teams[location.pathname.match(/^\/client\/([A-Z0-9]+)/)[1]].token
#   xoxd — DevTools → Application → Cookies → app.slack.com → `d` (starts xoxd-)
# SLACK_SESSION_TOKENS=xoxc-...|xoxd-...,xoxc-...|xoxd-...

# Notion (optional) — self-created Internal Integration
# https://www.notion.so/my-integrations → New integration
# Share target database with the integration
# NOTION_API_KEY=secret_...
# NOTION_DATABASE_ID=...
# NOTION_POLL_INTERVAL_MS=300000

# HTTP capture endpoint (optional) — used by desktop capture-agent
# Set to enable POST /v1/capture; pick a long random token.
# HTTP_AUTH_TOKEN=
# HTTP_PORT=3030

# Context Store embeddings (optional but recommended).
# Without OPENAI_API_KEY: Context Store works in FTS-only mode (no semantic search).
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_MODEL=text-embedding-3-small
# CONTEXT_STORE_TTL_DAYS=7
